# ============================================================================
#  KIS AI Quant Trader — 환경설정 템플릿
#  사용법: 이 파일을 .env 로 복사한 뒤 값을 채우세요.  (Windows: copy .env.example .env)
# ============================================================================

# ---------------------------------------------------------------- 실행 모드
# USE_MOCK_MODE=true  : KIS 서버를 전혀 호출하지 않고 내부 가상 체결 엔진 사용
#                       → 계좌 발급 전(10/12 이전) 전체 로직 검증용
# USE_MOCK_MODE=false : 실제 KIS 서버와 통신 (아래 인증정보 필수)
USE_MOCK_MODE=true

# vts  : 모의투자 도메인 (https://openapivts.koreainvestment.com:29443)  ← 대회용
# prod : 실전투자 도메인 (https://openapi.koreainvestment.com:9443)
KIS_ENV=vts

# true면 주문 직전에 실제 전송만 생략(그 외 전 과정 동일). 실서버 첫 연결 시 안전 점검용.
DRY_RUN=false

# ---------------------------------------------------------------- 인증 정보
# KIS 개발자센터(apiportal.koreainvestment.com)에서 발급
KIS_APP_KEY=
KIS_APP_SECRET=
# 종합계좌번호 8자리 - 상품코드 2자리 (모의투자는 보통 01)
KIS_ACCOUNT_NO=00000000-01
# 실시간 체결통보(WebSocket) 구독용 HTS ID. 없으면 체결통보 구독을 건너뜁니다.
KIS_HTS_ID=

# ---------------------------------------------------------------- 유량 제한
# KIS 유량 정책: 실전 계정 초당 20건 / 모의투자 계정 초당 2건 (계정 단위)
#   → KIS_ENV=vts 로 대회에 참가한다면 2를 유지하세요. 넘기면 EGW00201이 발생하고
#     최악의 경우 손절 주문이 거부됩니다.
REST_RATE_LIMIT=2
REST_BURST=2
RATE_LIMIT_SAFETY=0.9
HTTP_TIMEOUT=10
HTTP_MAX_RETRY=3
# 세션당 실시간 등록 한도(KIS 41건). 체결+호가 합산 기준.
WS_MAX_SUBSCRIPTIONS=40

# ---------------------------------------------------------------- 토스증권 (학습 데이터 전용)
# developers.tossinvest.com 에서 발급. 과거 일봉과 수급 데이터를 받는 용도로만 쓰며
# 장중 시세와 주문은 KIS로 나갑니다(대회 계좌가 KIS이므로).
TOSS_CLIENT_ID=
TOSS_CLIENT_SECRET=
# 토스 유량 한도는 차트 20 TPS / 수급 10 TPS. 아래는 여유를 둔 값입니다.
TOSS_CHART_TPS=10
TOSS_FLOW_TPS=5
# 종목당 수집할 일봉 수 (1500봉 ≈ 6년)
COLLECT_BARS=1500
COLLECT_FLOW_DAYS=1500

# ---------------------------------------------------------------- 유니버스
# 비우면 config/settings.py의 DEFAULT_UNIVERSE(대형주 40종목)를 사용합니다.
# UNIVERSE=005930,000660,373220,207940,005380
UNIVERSE_SIZE=20
MIN_TRADING_VALUE=3000000000
# 코스피200·코스닥150 + 대회 규정 필터를 적용한 종목 목록.
# scripts/refresh_universe.py 로 만든다. 비우면 DEFAULT_UNIVERSE(40종목)로 폴백.
#   python scripts/refresh_universe.py --all-stocks <전종목시세.csv> #       --kospi200 <코스피200.csv> --kosdaq150 <코스닥150.csv> --min-trading-value 3e9
UNIVERSE_FILE=config/universe.json
# 이 봉 수 미만 이력의 종목은 패널에서 제외한다. align_panel이 공통 날짜 교집합을
# 잡으므로 상장이 늦은 종목 하나가 전체 구간을 잘라낸다(신규 상장이 섞이면 붕괴).
MIN_HISTORY_BARS=750

# ---------------------------------------------------------------- 전략 / AI
MODEL_NAME=alpha_gbdt
SIGNAL_BUY_THRESHOLD=0.22
SIGNAL_SELL_THRESHOLD=-0.15
W_MODEL=0.50
W_TECHNICAL=0.30
W_CROSS_SECTION=0.20
LABEL_HORIZON=5
LABEL_PT_ATR=1.5
LABEL_SL_ATR=1.0
# 2차 모델(메타라벨링). 1차 신호를 따를지 말지 판단한다.
# 정밀도는 0.66→0.86으로 오르지만 신호의 절반을 막아 합성 데이터에서는 Sharpe가 떨어졌다.
# 실데이터로 재평가한 뒤 켜는 것을 권장한다.
USE_META_MODEL=false
CV_SPLITS=5
CV_EMBARGO=5

# ---------------------------------------------------------------- 리스크 관리
MAX_POSITIONS=8
# 대회 규정 단일 종목 한도는 50%다. strategy/eligibility.py 가 이 값과 50% 중
# 작은 쪽으로 클립하므로 실수로 넘겨도 규정을 위반하지 않는다.
MAX_POSITION_WEIGHT=0.18
MAX_SECTOR_WEIGHT=0.35
MAX_GROSS_EXPOSURE=0.90
TARGET_VOLATILITY=0.18

# 포지션 사이징 방식. vol_target = 변동성 타게팅 × 켈리 × 신호 × 레짐(기본)
# fixed = 종목당 FIXED_POSITION_WEIGHT 고정. 대회 꼬리 전략용이며, 변동성·켈리·레짐을
# 곱하지 않는다(곱하면 종목당 3%로 돌아가 익스포저가 6%대가 된다 — 실측).
# --- 장중 분봉 전략 ---
# 켜면 일봉 신호 대신 장중 돌파가 진입을 결정한다(strategy/intraday.py).
#   ① 현재가 >= 전일종가 x (1 + INTRADAY_TRIGGER_PCT)
#   ② 이번 분 거래량 >= INTRADAY_VOL_MULT x (전일 거래량 / 391)
# 청산 기본값은 규칙 없음 + 마감 정리다. 격자에서 종가 청산이 꼬리가 가장 두꺼웠다.
# 주문 지정가 폭 — 매수는 올라가는 가격을 추격하고(+0.4%는 체결률 61.5%),
# 매도는 내려가는 가격에 양보한다(-0.4%에서 99.71%). 비대칭이다.
BUY_LIMIT_BAND=0.02
SELL_LIMIT_BAND=0.004
USE_INTRADAY=false
INTRADAY_TRIGGER_PCT=0.03
INTRADAY_VOL_MULT=12.0
INTRADAY_TARGET_PCT=0.0
INTRADAY_STOP_PCT=0.0
INTRADAY_TRAIL_PCT=0.0
INTRADAY_TRAIL_ACTIVATE_PCT=0.0
# 아침 후보 스캔 — universe.json 스냅샷이 아니라 '오늘 움직이는 종목'을 구독한다.
# 후보 명부·교체 — 매 분 비우면 '하루의 첫 2건'만 사게 되어 선택이 작동하지 않는다.
INTRADAY_CANDIDATE_TTL=1
INTRADAY_SWAP_MARGIN=0.10
INTRADAY_MAX_SWAPS=0
INTRADAY_SCAN_HHMM=0905
INTRADAY_SCAN_TOP=40
INTRADAY_FLATTEN_HHMM=1515

SIZING_MODE=vol_target
FIXED_POSITION_WEIGHT=0.42
KELLY_FRACTION=0.25
KELLY_MAX_WEIGHT=0.20
STOP_LOSS_PCT=0.12
TAKE_PROFIT_PCT=0.0
TRAILING_ATR_MULT=2.2
TRAILING_ACTIVATE_PCT=0.025
MAX_HOLDING_BARS=30
# USE_INTRADAY=true 로 쓸 때는 1.0 으로 사실상 해제한다.
# risk_manager가 이것을 하드 트리거로 취급해 HALT -> 전량 청산 + 쿨다운을 건다.
# 분봉 전략은 익스포저 84%라 보유 종목이 평균 3.6%만 내려도 그날 거래가 끝난다.
DAILY_LOSS_LIMIT=0.03
# MDD 2단계 방어: soft(신규진입 차단+익스포저 축소) → hard(전량청산+쿨다운)
MDD_SOFT_LIMIT=0.07
MDD_HARD_LIMIT=0.12
DERISK_RATIO=0.5
COOLDOWN_MINUTES=60
CRASH_DROP_PCT=0.045
CRASH_LOOKBACK=10

# 출구 규칙 근거 (실데이터 21구간 x 30봉 out-of-sample · 수급 미사용)
#   데이터 지문 30d0cafd15bc1a5f (40종목 x 1138봉, 20220127~20260923)
#
#   원 설정(손절 3.5% / 익절 9%)        Sharpe -0.147  누적  -5.2%  익스포저 29.7%
#   손절 12%만  ← 현재 설정             Sharpe  0.425  누적 +12.1%  익스포저 35.8%
#   익절 제거만                        Sharpe -0.163  누적  -6.9%
#   트레일링 제거만                     Sharpe -0.089  누적  -3.7%
#   보유 10봉만                       Sharpe -0.560  누적 -13.8%
#   손절12 + 익절제거                   Sharpe  0.263  누적  +7.0%
#   동일가중 매수보유(벤치마크)            Sharpe  0.869  누적 +61.8%  MDD 22.2%
#
# 손절을 넓히는 것이 검증된 단일 최대 개선이다. **익절·트레일링·보유기간은 건드리지
# 않는다** — 익절 제거는 단독으로도(-0.163) 조합에서도(0.425 -> 0.263) 나빴다.
#
# 주의: 절대 수치는 데이터 지문마다 다르다. 같은 실행 안에서만 비교한다.
# 재측정: python scripts/ablate_exits.py --source data/cache --set exits

# ---------------------------------------------------------------- 종목 선정
# USE_TOP_K=true 면 절대 임계값(SIGNAL_BUY_THRESHOLD) 대신 점수 상위 K개를 골라
# 목표 익스포저를 채운다. 임계값 방식은 넘는 종목이 없으면 현금을 들기 때문에
# 상승장 참여율이 구조적으로 낮다(실측 평균 익스포저 28%).
USE_TOP_K=false
MIN_HOLDING_BARS=0
# 표본 부족 시 Kelly 배수. 대회처럼 기간이 짧으면 거래 이력이 모이지 않으므로
# 낮은 고정값은 안전이 아니라 노이즈에 맞추는 것과 같다.
KELLY_COLD_START_MULT=0.40

# ---------------------------------------------------------------- 대회
# 날짜를 비워 두면 대회 로직 전체가 꺼지고 평소 동작을 유지한다.
# 제16회 뱅키스 대학생 모의투자대회(AI 부문): 26.10.12~11.20, 거래일 30일.
COMP_START=
COMP_END=
# 수익률 초기화 가능 마지막 날(26.10.16). 이 날까지가 1단계다.
PHASE1_END=
# 1단계는 초기화 옵션이 하방을 덮으므로 집중 + 리스크 게이트 해제.
# 단일 종목 한도 50% 때문에 1종목이면 현금 50%가 남는다. 2종목 x 50%가
# 규정 안에서 가능한 최대 집중이며, 1종목 100% 몰빵은 규정 위반이다.
PHASE1_TOP_K=2
PHASE2_TOP_K=4
PHASE1_DISABLE_RISK=true

# 대회 최소 요건 — 못 채우면 수익률과 무관하게 실격이다(모두 체결 기준).
# OpenAPI 5회 이상 / 매매금액 5억원 이상 / 매매일수 5영업일 이상 /
# 코스피200·코스닥150 중 5종목 이상.
MIN_TRADE_COUNT=0
MIN_TRADE_AMOUNT=0
MIN_TRADE_DAYS=0
MIN_TRADE_SYMBOLS=0

# ---------------------------------------------------------------- 거래 비용
# 수수료 1.4bp, 증권거래세 15bp(매도시), 슬리피지 가정 5bp
FEE_BPS=1.4
TAX_BPS=15.0
SLIPPAGE_BPS=5.0

# ---------------------------------------------------------------- 운영
INITIAL_CAPITAL=100000000
LOOP_INTERVAL=3.0
LOG_LEVEL=INFO

# ---------------------------------------------------------------- Mock 설정
MOCK_SPEED=60
MOCK_SEED=20261012
MOCK_HISTORY_BARS=400
MOCK_FUTURE_BARS=1200
MOCK_PARTIAL_FILL_PROB=0.25
MOCK_REJECT_PROB=0.01

# ---------------------------------------------------------------- 대시보드
DASHBOARD_ENABLED=true
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8500
