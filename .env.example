# ============================================================================
#  KIS AI Quant Trader — 환경설정 템플릿
#  사용법: 이 파일을 .env 로 복사한 뒤 값을 채우세요.  (Windows: copy .env.example .env)
# ============================================================================

# ---------------------------------------------------------------- 실행 모드
# USE_MOCK_MODE=true  : KIS 서버를 전혀 호출하지 않고 내부 가상 체결 엔진 사용
#                       → 계좌 발급 전(10/12 이전) 전체 로직 검증용
# USE_MOCK_MODE=false : 실제 KIS 서버와 통신 (아래 인증정보 필수)
USE_MOCK_MODE=true

# vts  : 모의투자 도메인 (https://openapivts.koreainvestment.com:29443)  ← 대회용
# prod : 실전투자 도메인 (https://openapi.koreainvestment.com:9443)
KIS_ENV=vts

# true면 주문 직전에 실제 전송만 생략(그 외 전 과정 동일). 실서버 첫 연결 시 안전 점검용.
DRY_RUN=false

# ---------------------------------------------------------------- 인증 정보
# KIS 개발자센터(apiportal.koreainvestment.com)에서 발급
KIS_APP_KEY=
KIS_APP_SECRET=
# 종합계좌번호 8자리 - 상품코드 2자리 (모의투자는 보통 01)
KIS_ACCOUNT_NO=00000000-01
# 실시간 체결통보(WebSocket) 구독용 HTS ID. 없으면 체결통보 구독을 건너뜁니다.
KIS_HTS_ID=

# ---------------------------------------------------------------- 유량 제한
# KIS 유량 정책: 실전 계정 초당 20건 / 모의투자 계정 초당 2건 (계정 단위)
#   → KIS_ENV=vts 로 대회에 참가한다면 2를 유지하세요. 넘기면 EGW00201이 발생하고
#     최악의 경우 손절 주문이 거부됩니다.
REST_RATE_LIMIT=2
REST_BURST=2
RATE_LIMIT_SAFETY=0.9
HTTP_TIMEOUT=10
HTTP_MAX_RETRY=3
# 세션당 실시간 등록 한도(KIS 41건). 체결+호가 합산 기준.
WS_MAX_SUBSCRIPTIONS=40

# ---------------------------------------------------------------- 토스증권 (학습 데이터 전용)
# developers.tossinvest.com 에서 발급. 과거 일봉과 수급 데이터를 받는 용도로만 쓰며
# 장중 시세와 주문은 KIS로 나갑니다(대회 계좌가 KIS이므로).
TOSS_CLIENT_ID=
TOSS_CLIENT_SECRET=
# 토스 유량 한도는 차트 20 TPS / 수급 10 TPS. 아래는 여유를 둔 값입니다.
TOSS_CHART_TPS=10
TOSS_FLOW_TPS=5
# 종목당 수집할 일봉 수 (1500봉 ≈ 6년)
COLLECT_BARS=1500
COLLECT_FLOW_DAYS=1500

# ---------------------------------------------------------------- 유니버스
# 비우면 config/settings.py의 DEFAULT_UNIVERSE(대형주 40종목)를 사용합니다.
# UNIVERSE=005930,000660,373220,207940,005380
UNIVERSE_SIZE=20
MIN_TRADING_VALUE=3000000000

# ---------------------------------------------------------------- 전략 / AI
MODEL_NAME=alpha_gbdt
SIGNAL_BUY_THRESHOLD=0.22
SIGNAL_SELL_THRESHOLD=-0.15
W_MODEL=0.50
W_TECHNICAL=0.30
W_CROSS_SECTION=0.20
LABEL_HORIZON=5
LABEL_PT_ATR=1.5
LABEL_SL_ATR=1.0
# 2차 모델(메타라벨링). 1차 신호를 따를지 말지 판단한다.
# 정밀도는 0.66→0.86으로 오르지만 신호의 절반을 막아 합성 데이터에서는 Sharpe가 떨어졌다.
# 실데이터로 재평가한 뒤 켜는 것을 권장한다.
USE_META_MODEL=false
CV_SPLITS=5
CV_EMBARGO=5

# ---------------------------------------------------------------- 리스크 관리
MAX_POSITIONS=8
MAX_POSITION_WEIGHT=0.18
MAX_SECTOR_WEIGHT=0.35
MAX_GROSS_EXPOSURE=0.90
TARGET_VOLATILITY=0.18
KELLY_FRACTION=0.25
KELLY_MAX_WEIGHT=0.20
STOP_LOSS_PCT=0.035
TAKE_PROFIT_PCT=0.09
TRAILING_ATR_MULT=2.2
TRAILING_ACTIVATE_PCT=0.025
MAX_HOLDING_BARS=30
DAILY_LOSS_LIMIT=0.03
# MDD 2단계 방어: soft(신규진입 차단+익스포저 축소) → hard(전량청산+쿨다운)
MDD_SOFT_LIMIT=0.07
MDD_HARD_LIMIT=0.12
DERISK_RATIO=0.5
COOLDOWN_MINUTES=60
CRASH_DROP_PCT=0.045
CRASH_LOOKBACK=10

# ---------------------------------------------------------------- 거래 비용
# 수수료 1.4bp, 증권거래세 15bp(매도시), 슬리피지 가정 5bp
FEE_BPS=1.4
TAX_BPS=15.0
SLIPPAGE_BPS=5.0

# ---------------------------------------------------------------- 운영
INITIAL_CAPITAL=100000000
LOOP_INTERVAL=3.0
LOG_LEVEL=INFO

# ---------------------------------------------------------------- Mock 설정
MOCK_SPEED=60
MOCK_SEED=20261012
MOCK_HISTORY_BARS=400
MOCK_FUTURE_BARS=1200
MOCK_PARTIAL_FILL_PROB=0.25
MOCK_REJECT_PROB=0.01

# ---------------------------------------------------------------- 대시보드
DASHBOARD_ENABLED=true
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8500
